# Variáveis de ambiente para desenvolvimento local (frontend)
# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca comite este arquivo com valores preenchidos.

# URL pública do projeto Supabase (exposta ao navegador - seguro)
VITE_SUPABASE_URL=https://susztkudafpxcxkmahbj.supabase.co

# Chave pública anônima do Supabase (exposta ao navegador - seguro)
# Obtenha em: Supabase Dashboard → Settings → API → Project URL e anon public
VITE_SUPABASE_ANON_KEY=sua_anon_key_publica_aqui

# ============================================
# NÃO COLOQUE ESTAS VARIÁVEIS AQUI:
# ============================================
# SUPABASE_SECRET_KEY  → chave de serviço, apenas backend
# SUPABASE_PUBLISHABLE_KEY sem prefixo VITE_ → não é lida pelo Vite
# SUPABASE_JWKS_URL    → desnecessária no frontend
# Connection strings com senha (postgres:[senha]@...) → expõe credenciais do banco

# ============================================
# ROTAÇÃO NECESSÁRIA (faça no Supabase Dashboard):
# ============================================
# 1. Settings → API → API Keys: revogue a SUPABASE_SECRET_KEY exposta e gere uma nova
# 2. Settings → Database: rotacione a senha do usuário postgres
# A nova SUPABASE_SECRET_KEY deve ficar APENAS no backend, nunca no frontend.
